# Copy to .env for local development. NEVER commit .env. In Vercel, set the same names under Project > Settings > Environment Variables.

# Random string, at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`). Signs login cookies.
SESSION_SECRET=
# Google Sheet id (the long part of the sheet URL)
GOOGLE_SHEET_ID=
# Service account e-mail; share the sheet with it as Editor
GOOGLE_CLIENT_EMAIL=
# The private_key from the service-account JSON key. Keep the \n sequences; wrap in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional
# Default Location for Domestic POs when the Configuration sheet's Location cell is empty (default MWH)
# DEFAULT_PO_LOCATION=MWH
# Session lifetime in minutes when Configuration > Session Timeout is empty (default 60)
# SESSION_MINUTES=60
# Extra browser origins allowed to call the API (comma separated). Normally not needed.
# ALLOWED_ORIGINS=
# Local development without Google: STORE=memory (blocked in production)
# STORE=memory
